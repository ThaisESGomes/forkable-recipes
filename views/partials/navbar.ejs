<header class="navbar">
  <div class="container navbar-inner">
    <a href="/" class="navbar-brand">
      <svg aria-label="Logo" width="28" height="28" viewBox="0 0 24 24" fill="none">
        <circle cx="8" cy="5" r="2" stroke="currentColor" stroke-width="1.5"/>
        <circle cx="16" cy="5" r="2" stroke="currentColor" stroke-width="1.5"/>
        <circle cx="8" cy="19" r="2" stroke="currentColor" stroke-width="1.5"/>
        <path d="M8 7v10M16 7v4M16 11c-4 0-6 2-6 4v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
      <span class="brand-name">Forkable Recipes</span>
    </a>

    <nav class="navbar-nav">
      <a href="/recipes" class="nav-link">Receitas</a>
      <% if (currentUser) { %>
        <a href="/recipes/new" class="nav-link">+ Nova Receita</a>
        <% if (currentUser.role === 'ADMIN') { %>
          <a href="/admin" class="nav-link nav-link--admin">Admin</a>
        <% } %>
        <div class="nav-user">
          <span class="nav-username">👤 <%= currentUser.name.split(' ')[0] %></span>
          <form action="/auth/logout" method="POST" style="display:inline">
            <button type="submit" class="btn btn-ghost btn-sm">Sair</button>
          </form>
        </div>
      <% } else { %>
        <a href="/auth/login" class="btn btn-ghost btn-sm">Entrar</a>
        <a href="/auth/register" class="btn btn-primary btn-sm">Criar Conta</a>
      <% } %>
      <button data-theme-toggle class="btn-icon" aria-label="Alternar tema" title="Alternar tema">🌙</button>
    </nav>
  </div>
</header>
