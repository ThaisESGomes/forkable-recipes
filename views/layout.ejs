<!DOCTYPE html>
<html lang="pt-BR" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> — Forkable Recipes</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300..700&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🍴</text></svg>">
</head>
<body>
  <%- include('partials/navbar') %>

  <main class="main-content">
    <div class="container">
      <%- include('partials/flash') %>
      <%- body %>
    </div>
  </main>

  <footer class="footer">
    <div class="container footer-inner">
      <div class="footer-brand">
        <svg aria-label="Forkable Recipes" width="24" height="24" viewBox="0 0 24 24" fill="none">
          <circle cx="8" cy="5" r="2" stroke="currentColor" stroke-width="1.5"/>
          <circle cx="16" cy="5" r="2" stroke="currentColor" stroke-width="1.5"/>
          <circle cx="8" cy="19" r="2" stroke="currentColor" stroke-width="1.5"/>
          <path d="M8 7v10M16 7v4M16 11c-4 0-6 2-6 4v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        <span>Forkable Recipes</span>
      </div>
      <p class="footer-copy">Cozinhe, compartilhe e derive receitas. Plataforma aberta para chefs.</p>
    </div>
  </footer>

  <script src="/js/main.js"></script>
  <script>
    (function(){
      const t=document.querySelector('[data-theme-toggle]'),r=document.documentElement;
      let d=matchMedia('(prefers-color-scheme:dark)').matches?'dark':'light';
      r.setAttribute('data-theme',d);
      if(t) t.innerHTML=d==='dark'?'☀️':'🌙';
      if(t) t.addEventListener('click',()=>{
        d=d==='dark'?'light':'dark';
        r.setAttribute('data-theme',d);
        t.innerHTML=d==='dark'?'☀️':'🌙';
      });
    })();
  </script>
</body>
</html>